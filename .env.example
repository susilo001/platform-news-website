# Copy to .env. Never commit secrets.
DATABASE_URL="postgresql://news:news_local@localhost:5432/news?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
SITE_URL="http://localhost:3000"
ADMIN_EMAIL="your-verified-github-email@example.com"
# true enables PUBLIC sample content and read-only /demo; CMS writes stay disabled.
DEMO_MODE="false"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="news-media"
S3_ACCESS_KEY_ID="local-news"
S3_SECRET_ACCESS_KEY="local-news-password"
MEDIA_PUBLIC_URL="http://localhost:9000/news-media"
PREVIEW_SECRET="replace-with-another-random-32-byte-secret"
WORKER_POLL_MS="30000"
